<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Glow Beauty Studio — Luxury Salon &amp; Spa</title>
<meta name="description" content="Glow Beauty Studio — Premier luxury salon and spa for facials, hair care, bridal makeup, nail art, and holistic wellness.">
<meta name="theme-color" content="#19120f">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9C%A8%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
:root {
  --bg-dark: #19120f;
  --bg-dark-glass: rgba(25, 18, 15, 0.94);
  --gold: #c59b53;
  --gold-light: #dfc18b;
  --gold-grad: linear-gradient(135deg, #dfc18b 0%, #b3853b 100%);
  --cream: #faf5ee;
  --card-bg: #ffffff;
  --text-main: #2e231e;
  --text-muted: #6e5f58;
  --border: rgba(197, 155, 83, 0.25);
  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans: 'Jost', sans-serif;
  --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 20px 45px -10px rgba(25, 18, 15, 0.25);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 80px; }
body { font: 300 16px/1.8 var(--sans); color: var(--text-main); background: var(--cream); overflow-x: hidden; -webkit-font-smoothing: antialiased; }

h1, h2, h3, h4 { font-family: var(--serif); font-weight: 600; line-height: 1.15; color: var(--text-main); }
a { color: inherit; text-decoration: none; transition: 0.3s ease; }
ul { list-style: none; }
img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }

.eyebrow {
  display: inline-flex; align-items: center; gap: 0.6rem;
  font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.22em;
  color: var(--gold); font-weight: 600; margin-bottom: 0.6rem;
}
.eyebrow::before { content: ""; width: 24px; height: 1px; background: currentColor; }

h2 { font-size: clamp(2.2rem, 4.2vw, 3.4rem); margin-bottom: 1rem; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: 0.95rem 2.2rem; background: var(--gold-grad); color: #fff;
  border: 1px solid transparent; font: 500 0.8rem var(--sans); letter-spacing: 0.16em;
  text-transform: uppercase; border-radius: 3px; cursor: pointer; transition: all 0.35s ease;
  box-shadow: 0 8px 24px -8px rgba(179, 133, 59, 0.6);
}
.btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px -6px rgba(179, 133, 59, 0.8); color: #fff; }
.btn.btn-outline { background: transparent; border-color: #fff; color: #fff; box-shadow: none; }
.btn.btn-outline:hover { background: #fff; color: var(--bg-dark); }
.btn.btn-sm { padding: 0.6rem 1.4rem; font-size: 0.72rem; }

/* NAVBAR */
nav {
  position: fixed; inset: 0 0 auto; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 1.3rem clamp(1.2rem, 5vw, 4.5rem); color: #fff; transition: 0.4s ease;
}
nav.scrolled {
  background: var(--bg-dark-glass); backdrop-filter: blur(12px);
  padding-block: 0.85rem; border-bottom: 1px solid var(--border);
}
.logo { font: 600 2.1rem/1 var(--serif); color: #fff; letter-spacing: 0.04em; }
.logo small { display: block; font: 300 0.65rem var(--sans); letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-light); }

.nav-links { display: flex; align-items: center; gap: 2rem; }
.nav-links a {
  font-size: 0.75rem; letter-spacing: 0.16em; font-weight: 500;
  position: relative; padding: 0.2rem 0; color: #eae1d9;
}
.nav-links a::after {
  content: ""; position: absolute; left: 0; bottom: -3px; width: 0; height: 1.5px;
  background: var(--gold-light); transition: width 0.3s;
}
.nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
.nav-links a.active { color: var(--gold-light); }
.nav-toggle { display: none; background: none; border: 0; color: #fff; font-size: 1.8rem; cursor: pointer; }

/* HERO */
.hero {
  position: relative; min-height: 94vh; display: flex; align-items: center;
  padding: 8.5rem clamp(1.2rem, 5vw, 5rem) 5rem; color: #fff; background: var(--bg-dark);
  overflow: hidden;
}
.hero-bg { position: absolute; inset: 0; z-index: 1; opacity: 0.45; }
.hero::after {
  content: ""; position: absolute; inset: 0; z-index: 2;
  background: linear-gradient(90deg, rgba(25,18,15,0.96) 0%, rgba(25,18,15,0.72) 50%, rgba(25,18,15,0.25) 100%);
}
.hero-content { position: relative; z-index: 3; max-width: 42rem; animation: fadeIn 1.2s ease; }
.hero h1 { font-size: clamp(3.2rem, 7vw, 5.8rem); margin: 0.8rem 0 1.2rem; font-weight: 500; }
.hero h1 em { color: var(--gold-light); font-style: italic; font-weight: 400; }
.hero p { font-size: 1.05rem; margin-bottom: 2.2rem; color: #ded3cb; letter-spacing: 0.03em; }
.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }

/* 3D FLOATING HERO BADGE */
.hero-3d-badge {
  position: absolute; right: 5%; bottom: 12%; z-index: 4;
  background: rgba(25, 18, 15, 0.75); backdrop-filter: blur(15px);
  border: 1px solid var(--border); padding: 1.4rem 2rem; border-radius: 12px;
  box-shadow: 0 25px 50px rgba(0,0,0,0.5); transform-style: preserve-3d;
  animation: float3D 6s ease-in-out infinite; display: none;
}
@media (min-width: 1024px) { .hero-3d-badge { display: block; } }
.hero-3d-badge b { font: 600 2.2rem var(--serif); color: var(--gold-light); display: block; line-height: 1; }
.hero-3d-badge span { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; color: #ddd; }

@keyframes float3D {
  0%, 100% { transform: perspective(1000px) rotateY(-8deg) rotateX(6deg) translateY(0); }
  50% { transform: perspective(1000px) rotateY(6deg) rotateX(-6deg) translateY(-15px); }
}

/* SECTION LAYOUT */
.section { padding: clamp(4rem, 7vw, 6.5rem) clamp(1.2rem, 5vw, 5rem); max-width: 1400px; margin: auto; }
.section-head { text-align: center; max-width: 650px; margin: 0 auto 3.5rem; }
.section-head .eyebrow { justify-content: center; }

/* ========================================================
   3D TILT PICTURE COMPONENT (CSS 3D Engine)
======================================================== */
.tilt-card-3d {
  position: relative;
  perspective: 1200px;
  transform-style: preserve-3d;
  cursor: pointer;
}
.tilt-inner-3d {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 14px;
  overflow: hidden;
  transform-style: preserve-3d;
  transition: transform 0.15s ease-out, box-shadow 0.3s ease;
  box-shadow: var(--shadow-sm);
  background: #111;
}
.tilt-inner-3d::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.3) 0%, transparent 65%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  z-index: 5;
}
.tilt-card-3d:hover .tilt-inner-3d {
  box-shadow: 0 30px 60px -15px rgba(25, 18, 15, 0.45);
}
.tilt-card-3d:hover .tilt-inner-3d::after {
  opacity: 1;
}
.tilt-inner-3d img {
  transform: translateZ(0) scale(1);
  transition: transform 0.4s ease;
}
.tilt-card-3d:hover .tilt-inner-3d img {
  transform: translateZ(25px) scale(1.08);
}
.tilt-content-3d {
  position: absolute;
  inset: auto 0 0 0;
  padding: 2rem 1.4rem 1.4rem;
  background: linear-gradient(to top, rgba(20, 14, 11, 0.95) 0%, transparent 100%);
  color: #fff;
  z-index: 4;
  transform: translateZ(40px);
  transition: transform 0.3s ease;
}

/* ABOUT */
.about-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
.about-3d-box {
  position: relative; border-radius: 14px;
  aspect-ratio: 4/5;
}
.stats { display: flex; gap: 2.5rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border); }
.stats b { display: block; font: 600 2.4rem/1 var(--serif); color: var(--gold); margin-bottom: 0.3rem; }
.stats span { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }

/* SERVICES */
.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
.service-card {
  background: var(--card-bg); border-radius: 14px; overflow: hidden;
  box-shadow: var(--shadow-sm); border: 1px solid rgba(0,0,0,0.04);
  display: flex; flex-direction: column;
}
.service-img-3d { height: 240px; }
.service-body { padding: 1.6rem; display: flex; flex-direction: column; flex-grow: 1; }
.service-body h3 { font-size: 1.5rem; margin-bottom: 0.4rem; }
.service-body p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.2rem; flex-grow: 1; }
.service-meta {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 1.2rem; font-size: 0.85rem; border-top: 1px dashed #eee; padding-top: 0.8rem;
}
.service-price { font-weight: 600; color: var(--gold); font-size: 1.05rem; }

/* BRIDAL BANNER */
.bridal-banner {
  background: var(--bg-dark); color: #f5ece4; border-radius: 16px;
  display: grid; grid-template-columns: 1fr 1.1fr; overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.bridal-text { padding: clamp(2.5rem, 5vw, 4.5rem); display: flex; flex-direction: column; justify-content: center; }
.bridal-text h2 { color: #fff; }
.package-list { margin: 1.8rem 0 2rem; }
.package-list li {
  display: flex; justify-content: space-between; padding: 0.8rem 0;
  border-bottom: 1px solid rgba(223, 193, 139, 0.2); font-size: 0.95rem;
}
.package-list li strong { color: var(--gold-light); }

/* GALLERY GRID (3D TILT PICTURES) */
.gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; }
.gallery-3d-card { aspect-ratio: 1/1; }
.gallery-title-3d { font-family: var(--serif); font-size: 1.35rem; color: var(--gold-light); }
.gallery-tag-3d { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.15em; color: #ddd; }

/* FEATURES */
.features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.6rem; }
.feature-box {
  background: var(--card-bg); padding: 2rem 1.6rem; border-radius: 10px;
  border-top: 3px solid var(--gold); box-shadow: var(--shadow-sm);
  transition: transform 0.3s;
}
.feature-box:hover { transform: translateY(-4px); }
.feature-box h3 { font-size: 1.35rem; margin-bottom: 0.6rem; }
.feature-box p { font-size: 0.9rem; color: var(--text-muted); }

/* TESTIMONIALS */
.testimonials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.8rem; }
.testimonial-card {
  background: var(--card-bg); padding: 2rem; border-radius: 12px;
  box-shadow: var(--shadow-sm); position: relative; display: flex; flex-direction: column;
}
.stars { color: var(--gold); letter-spacing: 3px; font-size: 0.9rem; margin-bottom: 0.8rem; }
.testimonial-card p { font-size: 0.95rem; font-style: italic; color: var(--text-main); margin-bottom: 1.5rem; flex-grow: 1; }
.author { display: flex; align-items: center; gap: 0.9rem; }
.author-avatar {
  width: 44px; height: 44px; border-radius: 50%; background: var(--gold-grad);
  display: grid; place-items: center; font-family: var(--serif); font-weight: 600; color: #fff;
}
.author-info h4 { font-size: 1.05rem; }
.author-info span { font-size: 0.75rem; color: var(--text-muted); }

/* FAQ ACCORDION */
.faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
.faq-item { background: var(--card-bg); border-radius: 8px; border: 1px solid rgba(0,0,0,0.05); overflow: hidden; }
.faq-question {
  width: 100%; text-align: left; padding: 1.2rem 1.5rem; font-family: var(--serif);
  font-size: 1.25rem; font-weight: 600; background: none; border: 0; color: var(--text-main);
  display: flex; justify-content: space-between; align-items: center; cursor: pointer;
}
.faq-question span { transition: transform 0.3s; font-size: 1.4rem; color: var(--gold); }
.faq-answer { padding: 0 1.5rem 1.2rem; font-size: 0.92rem; color: var(--text-muted); display: none; }
.faq-item.active .faq-answer { display: block; }
.faq-item.active .faq-question span { transform: rotate(45deg); }

/* BOOKING & CONTACT */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
.contact-info { background: var(--bg-dark); color: #fff; padding: clamp(2rem, 4vw, 3.5rem); border-radius: 12px; }
.contact-info h2 { color: #fff; }
.contact-info p { color: #d6c8bf; margin-bottom: 1.8rem; }
.info-items li { display: flex; gap: 1rem; margin-bottom: 1.3rem; font-size: 0.95rem; align-items: center; }
.info-items i {
  width: 38px; height: 38px; border-radius: 50%; background: rgba(197, 155, 83, 0.2);
  color: var(--gold-light); display: grid; place-items: center; font-style: normal;
}
.contact-form-wrap {
  background: var(--card-bg); padding: clamp(2rem, 4vw, 3.5rem);
  border-radius: 12px; box-shadow: var(--shadow-lg);
}
.contact-form-wrap h3 { font-size: 1.8rem; margin-bottom: 1.5rem; }
form .form-group { margin-bottom: 1.2rem; }
form label { display: block; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.4rem; color: var(--text-muted); }
form input, form select {
  width: 100%; padding: 0.85rem; border: 1px solid #e2d8cf; border-radius: 4px;
  background: #fdfbf9; font: 300 0.95rem var(--sans); color: var(--text-main);
  transition: border-color 0.3s;
}
form input:focus, form select:focus { outline: none; border-color: var(--gold); background: #fff; }
form input.invalid, form select.invalid { border-color: #ba3939; background: #fff5f5; }
.form-note { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.8rem; }
.form-alert {
  display: none; padding: 1rem; border-radius: 4px; font-size: 0.9rem;
  margin-top: 1.2rem; background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534;
}

/* FOOTER */
footer {
  background: var(--bg-dark); color: #d6c7bd; padding: 4rem clamp(1.2rem, 5vw, 5rem) 2rem;
  border-top: 1px solid rgba(255,255,255,0.06);
}
.footer-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem; margin-bottom: 3rem; }
.socials { display: flex; gap: 1rem; }
.socials a {
  width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--border);
  display: grid; place-items: center; color: var(--gold-light); font-size: 0.85rem;
}
.socials a:hover { background: var(--gold); color: #fff; border-color: var(--gold); }
.footer-bottom {
  text-align: center; font-size: 0.8rem; opacity: 0.7;
  border-top: 1px solid rgba(255,255,255,0.06); padding-top: 2rem;
}

/* MODAL */
.modal {
  position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 200;
  display: none; place-items: center; padding: 2rem;
}
.modal.open { display: grid; }
.modal-content { max-width: 800px; max-height: 85vh; border-radius: 8px; overflow: hidden; }
.modal-close {
  position: absolute; top: 1.5rem; right: 2rem; background: none; border: 0;
  color: #fff; font-size: 2.5rem; cursor: pointer;
}

/* BACK TO TOP */
.top-btn {
  position: fixed; right: 1.5rem; bottom: 1.5rem; width: 44px; height: 44px;
  background: var(--bg-dark); border: 1px solid var(--gold); border-radius: 50%;
  color: var(--gold-light); font-size: 1.2rem; cursor: pointer; opacity: 0;
  pointer-events: none; transition: 0.3s ease; z-index: 90;
}
.top-btn.visible { opacity: 1; pointer-events: auto; }

/* MEDIA QUERIES */
@media (max-width: 980px) {
  .about-grid, .bridal-banner, .contact-grid { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .nav-toggle { display: block; }
  .nav-links {
    position: fixed; top: 0; right: -100%; width: 75%; max-width: 320px; height: 100vh;
    background: var(--bg-dark); flex-direction: column; justify-content: center;
    gap: 1.8rem; transition: right 0.4s ease; box-shadow: -5px 0 25px rgba(0,0,0,0.5);
  }
  .nav-links.open { right: 0; }
  .hero h1 { font-size: clamp(2.8rem, 11vw, 3.8rem); }
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
</head>
