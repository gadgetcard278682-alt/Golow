<!-- SCRIPTS & 3D ENGINE -->
<script>
// Navbar Scroll Blur Effect
const navbar = document.getElementById('navbar');
const topBtn = document.getElementById('topBtn');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 50);
  topBtn.classList.toggle('visible', window.scrollY > 600);
});

// Mobile Nav Toggle
const navToggle = document.getElementById('navToggle');
const navLinks = document.getElementById('navLinks');
navToggle.addEventListener('click', () => {
  navLinks.classList.toggle('open');
});
navLinks.querySelectorAll('a').forEach(link => {
  link.addEventListener('click', () => navLinks.classList.remove('open'));
});

// Back to Top Action
topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

// FAQ Accordion Toggle
document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const parent = btn.parentElement;
    const isActive = parent.classList.contains('active');
    document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));
    if (!isActive) parent.classList.add('active');
  });
});

// Service Auto-Select on "Book Service" Click
document.querySelectorAll('.select-service-btn').forEach(button => {
  button.addEventListener('click', () => {
    const serviceName = button.getAttribute('data-service');
    const selectEl = document.getElementById('service');
    if (selectEl && serviceName) {
      selectEl.value = serviceName;
      document.getElementById('book').scrollIntoView({ behavior: 'smooth' });
      document.getElementById('name').focus();
    }
  });
});

// Form Validation and Booking Confirmation
const bookingForm = document.getElementById('bookingForm');
const formAlert = document.getElementById('formAlert');
const dateInput = document.getElementById('date');

if (dateInput) {
  const today = new Date().toISOString().split('T')[0];
  dateInput.min = today;
}

bookingForm.addEventListener('submit', (e) => {
  e.preventDefault();
  let isValid = true;
  const inputs = bookingForm.querySelectorAll('input[required], select[required]');

  inputs.forEach(input => {
    if (!input.checkValidity() || !input.value.trim()) {
      input.classList.add('invalid');
      isValid = false;
    } else {
      input.classList.remove('invalid');
    }
  });

  if (!isValid) {
    formAlert.style.display = 'block';
    formAlert.style.background = '#fef2f2';
    formAlert.style.borderColor = '#fca5a5';
    formAlert.style.color = '#991b1b';
    formAlert.textContent = 'Please fill out all required fields correctly.';
    return;
  }

  const nameVal = document.getElementById('name').value.trim();
  const serviceVal = document.getElementById('service').value;

  formAlert.style.display = 'block';
  formAlert.style.background = '#f0fdf4';
  formAlert.style.borderColor = '#bbf7d0';
  formAlert.style.color = '#166534';
  formAlert.innerHTML = `Thank you, <strong>${nameVal}</strong>! Your appointment request for <strong>${serviceVal}</strong> has been received. Our team will contact you shortly to confirm.`;

  bookingForm.reset();
  if (dateInput) dateInput.min = new Date().toISOString().split('T')[0];
});

// Lightbox Modal for Gallery
const imageModal = document.getElementById('imageModal');
const modalImg = document.getElementById('modalImg');
const modalClose = document.getElementById('modalClose');

document.querySelectorAll('.gallery-3d-card').forEach(item => {
  item.addEventListener('click', () => {
    const fullSrc = item.getAttribute('data-full');
    modalImg.src = fullSrc;
    imageModal.classList.add('open');
  });
});

modalClose.addEventListener('click', () => imageModal.classList.remove('open'));
imageModal.addEventListener('click', (e) => {
  if (e.target === imageModal) imageModal.classList.remove('open');
});

/* ========================================================
   VANILLA 3D TILT ENGINE FOR PICTURES (TOUCH & MOUSE)
======================================================== */
document.querySelectorAll('.js-3d-tilt').forEach(card => {
  const inner = card.querySelector('.tilt-inner-3d');

  function handleMove(clientX, clientY) {
    const rect = card.getBoundingClientRect();
    const x = clientX - rect.left;
    const y = clientY - rect.top;

    const centerX = rect.width / 2;
    const centerY = rect.height / 2;

    const deltaX = (x - centerX) / centerX;
    const deltaY = (y - centerY) / centerY;

    // 3D Angle Calculations
    const rotateX = -deltaY * 16;
    const rotateY = deltaX * 16;

    inner.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    inner.style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
    inner.style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);
  }

  function resetTilt() {
    inner.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
  }

  // Mouse Events (PC)
  card.addEventListener('mousemove', (e) => handleMove(e.clientX, e.clientY));
  card.addEventListener('mouseleave', resetTilt);

  // Touch Events (Mobile)
  card.addEventListener('touchmove', (e) => {
    if (e.touches.length > 0) {
      handleMove(e.touches[0].clientX, e.touches[0].clientY);
    }
  }, { passive: true });
  card.addEventListener('touchend', resetTilt);
});
</script>
